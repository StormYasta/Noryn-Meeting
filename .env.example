# NORYN MEETING COPILOT - CONFIGURAÇÃO LOCAL-FIRST
# Por padrão, o sistema opera 100% LOCAL e OFFLINE (Custo = R$ 0,00).

# Provider padrão de IA: 'ollama', 'rule-engine', ou 'external' (opcional)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Transcrição Local Whisper: 'tiny', 'base', 'small'
WHISPER_MODEL=tiny
WHISPER_DEVICE=auto

# Intervalo da análise incremental em segundos (padrão: 35s)
ANALYSIS_INTERVAL_SECONDS=35

# Fallback opcional externo (DESABILITADO POR PADRÃO - Custo 0)
# Se habilitar, descomente e adicione a chave abaixo:
# OPENAI_API_KEY=
