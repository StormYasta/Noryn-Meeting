# Network: keep localhost when accessed through SSH local port forwarding
MEETING_PORT=8765
CORS_ORIGINS=http://localhost:5173

# Shared session: 1 owner (User A) + 1 viewer (User B)
PAIRING_CODE_LENGTH=6
MAX_VIEWERS=1
SESSION_TTL_MINUTES=480
DATA_DIR=/data
SAVE_AUDIO=false

# Streaming audio / lightweight VAD
AUDIO_SAMPLE_RATE=16000
AUDIO_QUEUE_MAX_FRAMES=2500
VAD_RMS_THRESHOLD=0.008
VAD_SILENCE_MS=650
VAD_PREROLL_MS=250
VAD_MIN_SPEECH_MS=280
VAD_MAX_SPEECH_SECONDS=12

# Speech-to-text. Start with small; use base on weaker servers.
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=pt
WHISPER_BEAM_SIZE=1

# Existing Noryn Ollama on host. Never expose Ollama publicly for this MVP.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=90
ANALYSIS_INTERVAL_SECONDS=90

LOG_LEVEL=INFO
