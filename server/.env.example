# Network: keep localhost when accessed through SSH local port forwarding
MEETING_PORT=8765
# `null` allows the packaged Electron file:// renderer; localhost:5173 is Vite dev.
CORS_ORIGINS=http://localhost:5173,null

# Shared session: 1 owner (User A) + 1 viewer (User B)
PAIRING_CODE_LENGTH=6
MAX_VIEWERS=1
SESSION_TTL_MINUTES=480
DATA_DIR=/data
SAVE_AUDIO=false
# Production default: load/probe Whisper and Ollama in background at startup.
WARMUP_AI=true

# Streaming audio / accuracy-first VAD
AUDIO_SAMPLE_RATE=16000
AUDIO_QUEUE_MAX_FRAMES=2500
VAD_RMS_THRESHOLD=0.008
# Intentionally slower commits: more context is preferred over live-caption latency.
VAD_SILENCE_MS=1100
VAD_PREROLL_MS=450
VAD_MIN_SPEECH_MS=450
VAD_MAX_SPEECH_SECONDS=20

# Speech-to-text. `small` is the MVP default; use medium/large-v3 on stronger GPUs.
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=pt
WHISPER_BEAM_SIZE=5
# Hint domain-specific vocabulary. Space-separated phrases are accepted by faster-whisper.
WHISPER_HOTWORDS=Noryn CRM Kanban WhatsApp Webmotors Supabase Evolution Google Calendar Gmail Outlook INPI marcas patentes licença mensalidade código-fonte exclusividade API webhook filiais atendentes usuários migração integração

# Existing Noryn Ollama on host. Never expose Ollama publicly for this MVP.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=90
ANALYSIS_INTERVAL_SECONDS=90

LOG_LEVEL=INFO
