{
  "name": "noryn-meeting-copilot",
  "version": "1.0.0",
  "description": "Copiloto comercial de reuniões em tempo real para Noryn CRM",
  "main": "dist-electron/electron/main.js",
  "author": "Noryn",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k -p \"[{name}]\" -n \"VITE,ELECTRON\" -c \"cyan,magenta\" \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build:electron": "tsc -p tsconfig.node.json",
    "build:react": "vite build",
    "build": "npm run build:electron && npm run build:react",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "dotenv": "^16.4.7",
    "lucide-react": "^1.16.0",
    "openai": "^4.86.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.11",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "wait-on": "^8.0.2"
  }
}
